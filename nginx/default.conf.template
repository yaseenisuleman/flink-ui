# Rendered by the nginx image entrypoint (envsubst); only variables set in the
# environment are replaced, so nginx's own $variables are left alone.

# Upstreams are resolved per request, so nginx starts even when the JobManager
# or the SQL Gateway is not up yet (or not deployed at all).
resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

server {
    listen ${NGINX_PORT};
    server_name _;

    root /usr/share/nginx/html;
    client_max_body_size ${MAX_UPLOAD_SIZE};

    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_request_buffering off;

    # The dashboard uses hash routes (#/...), so the only page is index.html
    location = / {
        add_header Cache-Control "no-cache";
        try_files /index.html =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SQL Gateway REST API, prefix stripped
    location /sql-gateway/ {
        set $sql_gateway ${SQL_GATEWAY_URL};
        rewrite ^/sql-gateway/(.*)$ /$1 break;
        proxy_pass $sql_gateway;
    }

    # Static files of the dashboard; anything else is the Flink REST API
    # (/overview, /jobs/..., /taskmanagers, /jars/upload, ...)
    location / {
        try_files $uri @flink;
    }

    location @flink {
        set $flink_rest ${FLINK_REST_URL};
        proxy_pass $flink_rest;
    }
}
